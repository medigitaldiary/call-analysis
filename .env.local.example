# Neon — https://neon.tech (free tier)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Sarvam AI — https://sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend — https://resend.com (free: 3k emails/mo)
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=radar@bondscanner.in

# Google Drive API — https://console.cloud.google.com (enable Drive API, create API key)
GOOGLE_API_KEY=your-google-api-key

# App URL (Vercel URL after deploy)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
